# Server Configuration
PORT=3001
NODE_ENV=development

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/church

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE=30m
JWT_REFRESH_TOKEN_EXPIRE=365d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# SMS Service (Fast2SMS)
SMS_ENABLED=false
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here
SMS_SENDER_ID=CHURCH

# CORS
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Email Configuration
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=Church Wallet System <your_email@gmail.com>

# EDV Bridge (pushes transactions into the EDV accounting system)
# Disabled by default — enabling also requires an edvApiKey set on each Church document
EDV_BRIDGE_ENABLED=false
EDV_BRIDGE_API_URL=http://localhost:4000
